{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/powersw2024/MyRoadmapTranslation/main/schema/kp.schema.json",
  "title": "RustWay 知识点（单个）",
  "description": "知识点的完整定义。内容文件放在 content/kps/ 下即被自动加载；提交前请用 `rustway import <file>` 或 `cargo run -- validate` 自检。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "difficulty", "minutes", "summary", "task", "refs", "quiz"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 32,
      "description": "全局唯一标识，建议格式 k<模块><章><序>，如 k1-3-1"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "知识点标题：简短、可搜索、独立成义"
    },
    "difficulty": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "1=入门 ★☆☆  2=中阶 ★★☆  3=进阶 ★★★"
    },
    "minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600,
      "description": "预计学习时长（分钟），含完成验证任务的时间"
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "description": "一句话概述，显示在知识图谱提示与卡片上；独立成句"
    },
    "outline": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 4 },
      "description": "要点大纲；detail_md 缺失时作为页面正文展示"
    },
    "prereqs": {
      "type": "array",
      "items": { "$ref": "#/$defs/kpId" },
      "description": "前置知识点 id 列表；必须已存在，且整张前置图不允许成环（服务端用 Kahn 算法检测）。宁多勿漏。"
    },
    "task": {
      "type": "string",
      "minLength": 20,
      "description": "动手验证任务：写清『做什么 + 如何客观确认做对了』；应是可检验的实践产出（运行结果/完成的作品/通过的测试等），不限领域"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "description": "引用出处，至少 1 条；优先官方文档 > 权威教材 > 经典论文",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "u"],
        "properties": {
          "t": { "type": "string", "minLength": 4, "description": "出处标题" },
          "u": { "type": "string", "pattern": "^https?://", "description": "http(s) 链接" }
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "description": "测试用例：支持三种题型（kind 缺省为 choice 选择题）。答对全部题目会自动点亮『掌握』状态。编程题由服务端 rustc 沙箱编译运行，并可经 AI 后端（本地 Ollama / OpenAI 兼容 API）做代码结构评价。",
      "items": {
        "anyOf": [
          {
            "title": "选择题（kind 缺省 = choice）",
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "opts", "answer", "why"],
            "properties": {
              "kind": { "const": "choice" },
              "q": { "type": "string", "minLength": 8, "description": "题干，独立可答（先答后看）" },
              "opts": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 }, "description": "选项" },
              "answer": { "type": "integer", "minimum": 0, "description": "正确项下标（0 起），必须小于 opts 长度（服务端校验）" },
              "why": { "type": "string", "minLength": 4, "description": "解析" }
            }
          },
          {
            "title": "填空题（blank）",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "q", "accept", "why"],
            "properties": {
              "kind": { "const": "blank" },
              "q": { "type": "string", "minLength": 8, "description": "题干，用 __ 标出空位" },
              "accept": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "可接受答案列表（比对时忽略大小写与首尾空格）" },
              "why": { "type": "string", "minLength": 4, "description": "解析" }
            }
          },
          {
            "title": "编程题（code）",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "prompt", "test_code", "why"],
            "properties": {
              "kind": { "const": "code" },
              "prompt": { "type": "string", "minLength": 8, "description": "题面：要求实现什么" },
              "starter": { "type": "string", "description": "起始代码（函数签名/骨架），学生在此基础上补全" },
              "test_code": { "type": "string", "minLength": 8, "description": "测试代码：注入 rustway_checker 模块（可 use super::*），与学习者代码合并后以 rustc --test 编译运行，全部通过即得分" },
              "why": { "type": "string", "minLength": 4, "description": "解析：考察点说明" }
            }
          }
        ]
      }
    },
    "domain": {
      "type": "string",
      "description": "可选。领域标签：本框架是通用学习框架，不限于计算机（如 数学 / 音乐 / 语言）。缺省视为通用。"
    },
    "detail_md": {
      "type": "string",
      "pattern": "^content/.+\\.md$",
      "description": "可选。详细讲解 Markdown 路径（相对仓库根）；文件必须随提交一并给出"
    },
    "tags": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "description": "标签：参与相似算法分词（权重最高），是自动关联的主要语义锚点"
    },
    "author": {
      "type": "string",
      "description": "可选。贡献者署名（GitHub 用户名）；当前加载器会忽略该字段，仅用于收集阶段的归属记录"
    }
  },
  "$defs": {
    "kpId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
